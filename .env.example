# ─── AI Provider ────────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Email / SMTP ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=youe_app_pasword_here
SMTP_USE_TLS=true
ALERT_FROM_NAME=Data Analyst Agent

# ─── Application ─────────────────────────────────────────────────────────────
APP_SECRET_KEY=change_this_to_a_long_random_string_minimum_32_chars
APP_ENV=production
LOG_LEVEL=INFO

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/analyst.db

# ─── Security ────────────────────────────────────────────────────────────────
# Admin password (bcrypt hash stored here, plain text never stored)
ADMIN_PASSWORD_HASH=
# Session timeout in minutes
SESSION_TIMEOUT_MINUTES=60
# Max upload size in MB
MAX_UPLOAD_MB=60

# ─── Scheduler ───────────────────────────────────────────────────────────────
SCHEDULER_TIMEZONE=Asia/Kolkata
